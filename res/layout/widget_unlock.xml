<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg"
    android:paddingStart="12dp" android:paddingEnd="5dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_target" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_target" android:textSize="11sp" android:textColor="#BAC2CE"/>
        <TextView android:id="@+id/widget_hz" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="—" android:textSize="20sp" android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" android:maxLines="1" android:textColor="#F2F5F9"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/widget_reapply" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/widget_btn" android:contentDescription="@string/widget_reapply">
        <ImageView android:id="@+id/widget_icon" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_gravity="center" android:src="@drawable/ui_refresh"
            android:importantForAccessibility="no" />
        <ProgressBar android:id="@+id/widget_spin" style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
            android:indeterminateOnly="true" android:indeterminateDuration="420"
            android:indeterminateTint="@android:color/white" android:indeterminateDrawable="@drawable/widget_rotate"
            android:interpolator="@android:anim/linear_interpolator"
            android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
